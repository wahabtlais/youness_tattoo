{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Younes Tattoo API - a Fastify modular monolith over PostgreSQL.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.js",
    "build": "esbuild src/main.ts src/cli.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist --packages=external --sourcemap",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "setup": "tsx src/cli.ts setup",
    "db:migrate": "tsx --import ./src/db/seed/register-assets.mjs src/cli.ts migrate",
    "db:rollback": "tsx --import ./src/db/seed/register-assets.mjs src/cli.ts rollback",
    "db:seed": "tsx --import ./src/db/seed/register-assets.mjs src/cli.ts seed",
    "db:seed:demo": "tsx --import ./src/db/seed/register-assets.mjs src/cli.ts seed --demo",
    "db:reset": "tsx --import ./src/db/seed/register-assets.mjs src/cli.ts reset",
    "owner:create": "tsx --import ./src/db/seed/register-assets.mjs src/cli.ts owner:create",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:reset:demo": "tsx --import ./src/db/seed/register-assets.mjs src/cli.ts reset --demo"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@node-rs/argon2": "^2.2.2",
    "@younes/contracts": "*",
    "fastify": "^5.12.7",
    "file-type": "^22.2.0",
    "kysely": "^0.29.7",
    "nodemailer": "^10.2.1",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.0.5"
  }
}
