# EXAMPLE reverse proxy: HTTPS for the domain (certificates obtained and
# renewed by Caddy itself), everything passed to the app on the private
# network. The app sets its own security headers (CSP, HSTS, frame and
# referrer policies); Caddy adds compression and keeps request sizes sane.

{$SITE_DOMAIN} {
	encode zstd gzip

	# uploads are at most 20 MB (the API refuses more); everything else is small
	request_body {
		max_size 25MB
	}

	reverse_proxy app:3001 {
		# the app trusts X-Forwarded-For only because TRUST_PROXY=true and
		# only this proxy can reach it
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output stdout
		format json
	}
}

# www -> the bare domain
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}
