# EXAMPLE production settings. Copy to production.env ON THE SERVER, fill
# every value, keep it out of Git (it is ignored) and readable only by root.
# Generate secrets with:  openssl rand -base64 32   (or -hex 24 for passwords)

SITE_DOMAIN=younestattoo.example
PUBLIC_ORIGIN=https://younestattoo.example
# EXTRA_ORIGINS=https://www.younestattoo.example

# PostgreSQL roles (used by compose.example.yaml to build the URLs)
POSTGRES_SUPERUSER_PASSWORD=
YOUNES_MIGRATOR_PASSWORD=
YOUNES_APP_PASSWORD=

# 32 random bytes, base64 - encrypts authenticator secrets. Back it up with
# the database: without it, two-factor must be set up again.
TOTP_ENC_KEY=

# Lets the first owner be created from the browser once; remove it afterwards
# (or leave it unset and use: node server/dist/cli.js owner:create)
# OWNER_SETUP_TOKEN=

# Outgoing email (notices to the studio, password resets) - a transactional
# provider's SMTP details. Nothing is ever emailed to clients automatically.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Younes Tattoo <studio@younestattoo.example>

# The assistant stays off unless both are set
AI_ENABLED=false
# OPENROUTER_API_KEY=
