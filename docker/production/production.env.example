# EXAMPLE production settings. `./deploy.sh init your.domain` copies this to
# production.env with every secret generated; fill the email settings by hand.
# Keep production.env out of Git (it is ignored) and readable only by you.
# Generate secrets by hand with:  openssl rand -base64 32   (or -hex 24 for passwords)

SITE_DOMAIN=younestattoo.example
PUBLIC_ORIGIN=https://younestattoo.example
# EXTRA_ORIGINS=https://www.younestattoo.example

# How the site is reached (see compose.example.yaml):
#   false - a web server already on this machine proxies to 127.0.0.1:APP_PORT
#   true  - the bundled Caddy takes ports 80/443 and handles HTTPS
USE_CADDY=false
APP_PORT=3001

# PostgreSQL roles (used by compose.example.yaml to build the URLs)
POSTGRES_SUPERUSER_PASSWORD=
YOUNES_MIGRATOR_PASSWORD=
YOUNES_APP_PASSWORD=

# 32 random bytes, base64 - encrypts authenticator secrets. Back it up with
# the database: without it, two-factor must be set up again.
TOTP_ENC_KEY=

# The authenticator step at sign-in. false: the password alone signs in and
# stays signed in for a year on that browser. true: password + authenticator
# code (sessions 12 idle hours / 30 days). Restart the app after changing it.
TWO_FACTOR=false

# Lets the first owner be created from the browser once; remove it afterwards
# (or leave it unset and use: ./deploy.sh owner)
# OWNER_SETUP_TOKEN=

# Outgoing email (notices to the studio, password resets, the client's
# receipt) - a transactional provider's SMTP details. Until these are set,
# the site works but nothing is sent (Settings -> Email shows the failures).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Younes Tattoo <studio@younestattoo.example>

# The assistant stays off unless both are set
AI_ENABLED=false
# OPENROUTER_API_KEY=
