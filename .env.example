# Copy to .env.local (git-ignored) and fill in. See docs/ARCHITECTURE.md.
#
# Anything prefixed VITE_ is compiled into the public JavaScript bundle and
# readable by every visitor. Only public values go here.
#
# AI provider keys, search API keys, messaging tokens and any other secret
# must NEVER be VITE_ variables: they live on the server (the future API),
# which the site calls through VITE_API_BASE_URL.

# Base URL of the site's own API. Unset today: the work archive is static.
VITE_API_BASE_URL=
